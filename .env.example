# AI Job Search Agent — environment variables
# Copy to .env for local runs. GitHub Actions receives the same values
# through repository Secrets with matching names.

# Required
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Gmail IMAP
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Optional Adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LLM selection and budget
# Leave empty to use the free-model fallback chain.
OPENROUTER_MODEL=
MAX_LLM_JOBS_PER_RUN=25
LLM_REQUEST_DELAY=2.0
MAX_DESCRIPTION_CHARS=2200
MAX_EMAIL_BODY_CHARS=3500

# Notification thresholds
SCORE_THRESHOLD_SILENT=60
SCORE_THRESHOLD_NOTIFY=75
SCORE_THRESHOLD_PRIORITY=85

# Candidate/job hard filters
REMOTE_ONLY=true
ALLOW_HYBRID=false
ALLOW_ONSITE=false
ALLOW_INTERNSHIP=false
ALLOW_VOLUNTEER=false
REQUIRED_KEYWORDS=
REQUIRED_KEYWORDS_MODE=any
EXTRA_BLOCKLIST_KEYWORDS=

# Gmail cost controls
EMAIL_DAYS_BACK=3
MAX_EMAILS=10
EMAIL_ALLOWED_SUBJECTS=job alert,jobs,vacancies,vacancy,ваканс,recommended for you,job recommendation
EMAIL_IGNORED_SUBJECTS=profile,connection,contact,viewed,popular in your network,people you may know,публикац,результатах поиска

# Legacy values are no longer used by the current OpenRouter implementation:
# XIAOMI_API_KEY=
# RAPIDAPI_KEY=
# GEMINI_API_KEYS=

# ── v4.1: география и тематика ─────────────────────────────
# Блокируется только Россия как юрисдикция. Русский ЯЗЫК не блокируется:
# Украина, Казахстан, Армения, Грузия, Прибалтика, Кипр и т.д. проходят
# и получают бонус к score.
# Беларусь заблокирована по умолчанию (санкции, платёжные ограничения).
BLOCK_BELARUS=true

# Требовать признак AI или автоматизации в названии/описании.
# Без этого очередь забивают саппорт-агенты и менеджеры без AI-контекста.
REQUIRE_TOPICAL_CORE=true

# Сколько подряд идущих сбоев LLM допустимо до остановки пакета.
# Одиночный непарсящийся ответ больше не прерывает прогон.
MAX_CONSECUTIVE_LLM_FAILURES=5

# Формат работы
REMOTE_ONLY=true
ALLOW_HYBRID=false

# ── Резервные LLM-провайдеры ───────────────────────────────
# Цепочка: OpenRouter -> Groq -> Gemini -> Cerebras.
# У каждого СВОЙ независимый бесплатный дневной лимит. Исчерпание
# одного не останавливает прогон — управление уходит следующему.
# Провайдер без ключа молча пропускается: достаточно вписать ключ.
#
# Groq     — console.groq.com/keys
# Gemini   — aistudio.google.com/apikey
# Cerebras — cloud.cerebras.ai
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Модели по провайдерам можно переопределить, не трогая код
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# gemini-flash-latest — алиас Google на текущую модель. Жёстко зашитые
# версии протухают: gemini-2.5-flash и gemini-2.0-flash отдают 404.
# Несколько ключей через запятую = несколько дневных лимитов.
GEMINI_MODELS=gemini-flash-latest,gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_API_KEYS=
CEREBRAS_MODELS=llama-3.3-70b

# ── Лимиты частоты запросов (запросов в минуту) ────────────
# Темп выдерживается ПРЕВЕНТИВНО скользящим окном, а не по факту 429.
# Минутный лимит и дневная квота обрабатываются по-разному:
# первый — пауза и повтор, вторая — переход к следующему провайдеру.
OPENROUTER_RPM=20
GROQ_RPM=25
GEMINI_RPM=12
CEREBRAS_RPM=25
RATE_LIMIT_RETRIES=3

# ── Manus ──────────────────────────────────────────────────
# НЕ ПОДКЛЮЧЁН намеренно. Manus API (api.manus.ai) — это управление
# агентными задачами, а не инференс модели: нет /chat/completions и нет
# параметра model. Плюс ~150 кредитов за задачу (~$1.5) против долей
# цента у обычного LLM API. Переменные MANUS_* можно удалить из .env.

# ── Персональные пороги фильтрации ──────────────────────────
# Оба параметра намеренно пустые/нулевые в репозитории: это личные
# настройки владельца инстанса, а не часть логики агента.

# Минимальная зарплата в USD/мес. 0 = фильтр выключен.
MIN_SALARY_USD=0

# Дополнительные маркеры sync-first формата работы, через запятую.
# Дополняют SYNC_FIRST_MARKERS из config.py без правки кода.
EXTRA_SYNC_FIRST_MARKERS=
